n\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"locale\",\"og-image.jpg\",\"d\"],[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/37860238b2853f22.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/99ee0421784c5987.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/b5f1e26e33d76a98.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/2ed58c56b809ae98.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/chunks/d819e9edd5e699da.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-4\",{\"src\":\"/_next/static/chunks/a12562f1abed315a.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-5\",{\"src\":\"/_next/static/chunks/768cf98972854b3c.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-6\",{\"src\":\"/_next/static/chunks/cd6b273937aab3d9.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-7\",{\"src\":\"/_next/static/chunks/7474f904b3758233.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-8\",{\"src\":\"/_next/static/chunks/b9cb795370f9c432.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-9\",{\"src\":\"/_next/static/chunks/ff68b33237ba2b83.js\",\"async\":true,\"nonce\":\"$undefined\"}]],\"$L4\"]}],{\"children\":[\"__PAGE__\",[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"$L5\",null,{\"Component\":\"$6\",\"searchParams\":{},\"params\":{\"locale\":\"og-image.jpg\"}}],[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/4dae12961bcba517.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/ea6607505e2a81d2.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1353ab2918388544.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"$L7\",null,{\"children\":[\"$L8\",[\"$\",\"$L9\",null,{\"promise\":\"$@a\"}]]}]]}],{},null,false]},null,false]},null,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$Lb\",null,{\"children\":\"$Lc\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$Ld\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$e\",null,{\"fallback\":null,\"children\":\"$Lf\"}]}]}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$10\",[]],\"s\":false,\"S\":false}\n"])</script><script>self.__next_f.push([1,"14:T68d,"])</script><script>self.__next_f.push([1,"Chào mừng quý khách đến với cổng thông tin điện tử của Công ty Cổ phần Tà Lùng Quang Minh.\n\nKhi tiến hành truy cập và tương tác trên website, quý khách được xem là đã thấu hiểu và chấp thuận các quy định dưới đây.\n\n### 1. NGHĨA VỤ CỦA KHÁCH HÀNG\n- Đảm bảo tính trung thực và chính xác của các thông tin được cung cấp qua các biểu mẫu báo giá, ứng tuyển hoặc liên hệ.\n- Tuyệt đối nghiêm cấm các hành vi phát tán mã độc, can thiệp hoặc khai thác trái phép hệ thống cơ sở dữ liệu của chúng tôi.\n\n### 2. BẢN QUYỀN VÀ SỞ HỮU TRÍ TUỆ\n- Toàn bộ nội dung văn bản, nhận diện thương hiệu, hình ảnh và mã nguồn trên website là tài sản trí tuệ thuộc quyền quản lý của Công ty Cổ phần Tà Lùng Quang Minh.\n- Việc sao chép, phân phối hoặc sử dụng cho mục đích thương mại khi chưa có văn bản đồng ý từ công ty đều vi phạm pháp luật.\n\n### 3. CHÍNH SÁCH MIỄN TRỪ\n- Thông tin niêm yết trên website mang tính chất minh họa và giới thiệu năng lực. Tùy theo thời điểm và thực tế hợp đồng, các điều khoản vận hành có thể điều chỉnh. Chúng tôi không chịu trách nhiệm pháp lý cho các quyết định dựa hoàn toàn vào nội dung website mà không qua tư vấn trực tiếp.\n\n### 4. QUYỀN CẬP NHẬT\nCông ty bảo lưu quyền tinh chỉnh, thay đổi hoặc xóa bỏ các điều khoản này tại bất kỳ thời điểm nào mà không cần gửi thông báo trước."])</script><script>self.__next_f.push([1,"15:T5df,"])</script><script>self.__next_f.push([1,"Công ty Cổ phần Tà Lùng Quang Minh coi trọng và cam kết bảo vệ tuyệt đối an toàn dữ liệu cá nhân cũng như thông tin kinh doanh của đối tác.\n\n### 1. PHẠM VI THU THẬP\nHệ thống chỉ ghi nhận các dữ liệu do người dùng chủ động cung cấp qua biểu mẫu (bao gồm: Họ tên, số điện thoại, email, nội dung yêu cầu) và các dữ liệu truy cập ẩn danh (cookies) nhằm mục đích thống kê.\n\n### 2. MỤC ĐÍCH SỬ DỤNG\nDữ liệu thu thập được dùng duy nhất cho mục đích:\n- Phân tích yêu cầu và liên hệ tư vấn giải pháp, cung cấp báo giá.\n- Hỗ trợ giải quyết các sự cố liên quan đến quy trình vận hành.\n- Cải thiện trải nghiệm giao diện người dùng trên website.\n\n### 3. CAM KẾT BẢO MẬT\nChúng tôi áp dụng các tiêu chuẩn mã hóa dữ liệu tiên tiến nhất. Mọi thông tin của khách hàng được bảo lưu trong hệ thống nội bộ, cam kết KHÔNG bán, trao đổi hay chuyển nhượng cho bất kỳ bên thứ ba nào, ngoại trừ trường hợp có yêu cầu từ Cơ quan chức năng theo quy định của pháp luật.\n\n### 4. QUYỀN LỢI CỦA NGƯỜI DÙNG\nQuý khách có toàn quyền yêu cầu trích xuất, chỉnh sửa hoặc xóa bỏ thông tin cá nhân khỏi hệ thống của chúng tôi bất cứ lúc nào thông qua email hỗ trợ chính thức: **info@talunglogistics.com**."])</script><script>self.__next_f.push([1,"4:[\"$\",\"html\",null,{\"lang\":\"og-image.jpg\",\"className\":\"inter_dfbb94ae-module__cY9fIW__variable montserrat_5f7a9fb1-module__ptzAra__variable\",\"children\":[[\"$\",\"$L11\",null,{\"gtmId\":\"GTM-5BD4XCML\"}],[\"$\",\"body\",null,{\"children\":[\"$\",\"$L12\",null,{\"children\":[\"$\",\"$L13\",null,{\"locale\":\"og-image.jpg\",\"messages\":{\"Common\":{\"loading\":\"Đang tải...\",\"error\":\"Đã xảy ra lỗi. Vui lòng thử lại sau.\",\"readMore\":\"Xem chi tiết\"},\"Quotes\":{\"title\":\"Yêu Cầu Báo Giá Dịch Vụ B2B\",\"subtitle\":\"Điền thông tin lô hàng để nhận báo giá chi tiết trong vòng 30 phút\"},\"Navigation\":{\"home\":\"Trang chủ\",\"services\":\"Dịch Vụ\",\"servicesSub\":{\"warehouse\":\"Dịch vụ kho bãi tại Tà Lùng\",\"transloading\":\"Dịch vụ sang tải và lưu đỗ\",\"transport\":\"Dịch vụ vận tải\",\"customs\":\"Dịch vụ đại lý hải quan\",\"other\":\"Dịch vụ khác\"},\"servicesSlug\":{\"warehouse\":\"kho-bai-ta-lung\",\"transloading\":\"sang-tai-luu-do\",\"transport\":\"van-tai\",\"customs\":\"dai-ly-hai-quan\",\"other\":\"\"},\"manifesto\":\"Tuyên ngôn\",\"careers\":\"Tuyển dụng\",\"about\":\"Giới Thiệu\",\"news\":\"Tin Tức\",\"newsSub\":{\"logistics\":\"Logistics\",\"importExport\":\"Xuất nhập khẩu\",\"market\":\"Thị trường\",\"other\":\"Khác\"},\"newsSlug\":{\"logistics\":\"logistics\",\"importExport\":\"xuat-nhap-khau\",\"market\":\"thi-truong\"},\"contact\":\"Liên Hệ\"},\"HeaderActions\":{\"tracking\":\"Tra cứu vận đơn\",\"quote\":\"Nhận Báo Giá\"},\"CtaButton\":{\"quote\":\"Yêu Cầu Báo Giá Ngay\"},\"General\":{\"search\":\"Tìm kiếm\",\"language\":\"Ngôn ngữ\",\"theme\":\"Giao diện\",\"viewAll\":\"Xem tất cả\",\"viewAllServices\":\"Khám Phá Toàn Bộ Dịch Vụ\",\"contact\":\"Liên hệ\",\"share\":\"CHIA SẺ\",\"back\":\"Quay lại\",\"exploreMore\":\"Khám phá thêm các giải pháp khác\",\"viewDetails\":\"Xem chi tiết\"},\"Social\":{\"facebook\":\"Facebook\",\"wechat\":\"WeChat\",\"zalo\":\"Zalo\",\"whatsapp\":\"WhatsApp\"},\"Hero\":{\"label\":\"ĐỐI TÁC LOGISTICS CHIẾN LƯỢC TẠI CỬA KHẨU QUỐC TẾ TÀ LÙNG\",\"title\":\"KẾT NỐI BIÊN GIỚI\\nVƯƠN TỚI TOÀN CẦU\",\"subtitle\":\"Khẳng định vị thế từ năm 2008, Tà Lùng Quang Minh tự hào mang đến các giải pháp thông quan, lưu bãi và vận tải đa phương thức an toàn, tốc độ và tối ưu chi phí nhất.\",\"ctaServices\":\"Khám Phá Dịch Vụ\",\"ctaContact\":\"Nhận Tư Vấn Chuyên Sâu\"},\"Kpi\":{\"storageTitle\":\"Diện Tích Kho Bãi\",\"storageValue\":\"25 Ha\",\"storageDesc\":\"Quy mô 3 bãi trọng điểm\",\"containerTitle\":\"Năng Lực Xử Lý\",\"containerValue\":\"100+\",\"containerDesc\":\"Container thông quan mỗi ngày\",\"customsTitle\":\"Tốc Độ Thông Quan\",\"customsValue\":\"Dưới 2 Giờ\",\"customsDesc\":\"Thời gian hoàn thiện thủ tục\"},\"AboutPage\":{\"heroTitle\":\"VỀ TÀ LÙNG QUANG MINH\",\"heroSubtitle\":\"Hơn một thập kỷ kiến tạo chuỗi cung ứng thông suốt tại Cửa khẩu Quốc tế Tà Lùng\",\"intro\":{\"title\":\"TỔNG QUAN DOANH NGHIỆP\",\"content\":\"Được thành lập từ năm 2008 với tiền thân là Công ty TNHH Thương mại Vận tải Phú Anh, Công ty Cổ phần Tà Lùng Quang Minh đã nhanh chóng vươn mình trở thành thế lực hàng đầu trong ngành logistics vùng biên. Nắm bắt dòng chảy thương mại Việt - Trung qua Cửa khẩu Quốc tế Tà Lùng, chúng tôi đã đầu tư mạnh mẽ vào hệ thống kho bãi và địa điểm tập kết hàng hóa đạt chuẩn quốc tế.\\n\\nHệ sinh thái dịch vụ của chúng tôi bao trùm toàn diện: Kho bãi, Bến xe, Đại lý Hải quan, và Vận tải hàng hóa quốc tế đa phương thức\"},\"missionTitle\":\"Sứ Mệnh \u0026 Tầm Nhìn\",\"missionText\":\"Sứ mệnh của chúng tôi là xóa bỏ mọi rào cản thông quan, tối ưu hóa chuỗi cung ứng bằng sự minh bạch và tốc độ. Tầm nhìn chiến lược vươn lên trở thành mắt xích quan trọng nhất trên tuyến hành lang kinh tế Việt - Trung.\",\"timelineTitle\":\"DẤU ẤN PHÁT TRIỂN\",\"timeline\":{\"stage1_year\":\"2008\",\"stage1_text\":\"Thành lập Công ty TNHH Thương mại Vận tải Phú Anh, đặt những viên gạch đầu tiên cho dịch vụ vận tải biên mậu.\",\"stage2_year\":\"Đổi Mới\",\"stage2_text\":\"Chuyển đổi thành Công ty Cổ phần Tà Lùng Quang Minh, mở rộng đầu tư hạ tầng lên đến 25 ha, thiết lập tiêu chuẩn thông quan mới.\",\"stage3_year\":\"Tương Lai\",\"stage3_text\":\"Tích hợp hoàn thiện hệ thống cửa khẩu Tà Lùng - Chi Ma, kiến tạo chuỗi dịch vụ logistics dọc tuyến biên giới.\"},\"facilities\":{\"warehouseTitle\":\"HẠ TẦNG KHO BÃI QUY MÔ\",\"warehouseContent\":\"Sở hữu 3 cụm bãi chiến lược: Tà Lùng Quang Minh, Vũ Thành và Sơn Cảng với tổng diện tích lên tới 25 ha. Cơ sở hạ tầng được thiết kế khép kín, đáp ứng hoàn hảo các tiêu chuẩn khắt khe nhất về lưu trữ và sang tải hàng hóa tải trọng lớn.\",\"transportTitle\":\"NĂNG LỰC VẬN TẢI ĐA DẠNG\",\"transportContent\":\"Vận hành đội xe hùng hậu với đủ loại tải trọng, sẵn sàng đáp ứng mọi bài toán vận chuyển đa phương thức của doanh nghiệp một cách linh hoạt và an toàn tuyệt đối.\"},\"process\":{\"title\":\"QUY TRÌNH VẬN HÀNH CHUYÊN NGHIỆP\",\"steps\":{\"1\":{\"title\":\"Tiếp Nhận \u0026 Đánh Giá\",\"desc\":\"Tiếp nhận kế hoạch, chứng từ và tư vấn phương án tối ưu\"},\"2\":{\"title\":\"Khai Báo Hải Quan\",\"desc\":\"Xử lý thủ tục pháp lý, khai báo thông quan siêu tốc\"},\"3\":{\"title\":\"Điều Phối Phương Tiện\",\"desc\":\"Phân luồng và điều phối xe vào khu vực chuyển tải chuyên dụng\"},\"4\":{\"title\":\"Sang Tải An Toàn\",\"desc\":\"Sang tải hàng hóa với hệ thống máy móc và đội ngũ chuyên nghiệp\"},\"5\":{\"title\":\"Hoàn Thiện \u0026 Bàn Giao\",\"desc\":\"Hoàn tất thủ tục xuất bãi và theo dõi hành trình chặng cuối\"}}},\"vision\":{\"title\":\"ĐỊNH HƯỚNG TƯƠNG LAI\",\"content\":\"Tà Lùng Quang Minh đang trong giai đoạn chuyển mình mạnh mẽ, tập trung số hóa quy trình và nâng cấp toàn diện cơ sở hạ tầng kho bãi logistics.\\n\\nTham vọng của chúng tôi không dừng lại ở Tà Lùng. Mục tiêu dài hạn là kết nối liền mạch các hoạt động kinh doanh vào hệ thống cửa khẩu Tà Lùng và Chi Ma, thiết lập một dải dịch vụ cửa khẩu khép kín chạy dọc biên giới. Qua đó, khẳng định vị thế nút giao trọng điểm kết nối thương mại hai nước Việt - Trung.\"},\"offices\":{\"title\":\"HỆ THỐNG CHI NHÁNH\",\"halong\":\"Số 29 Lê Duẩn, phường Bãi Cháy, TP. Hạ Long, Quảng Ninh\",\"caobang\":\"Khu vực Cửa khẩu Quốc tế Tà Lùng, xã Phục Hoà, tỉnh Cao Bằng\",\"addressCB\":\"Văn phòng tại Cao Bằng\",\"addressQN\":\"Văn phòng tại Quảng Ninh\"}},\"FeaturedServices\":{\"title\":\"Giải Pháp Logistics Toàn Diện\",\"description\":\"Cung cấp chuỗi dịch vụ khép kín, thiết kế may đo nhằm giải quyết triệt để các bài toán vận hành và thông quan của doanh nghiệp.\"},\"LatestNews\":{\"title\":\"Tin Tức \u0026 Sự Kiện\",\"viewAll\":\"Xem tất cả tin tức\",\"seoTitle\":\"Cập nhật thông tin Logistics biên mậu Việt - Trung\",\"seoContent\":\"Chào mừng bạn đến với chuyên mục tin tức của \u003cbold\u003eTà Lùng Logistics\u003c/bold\u003e. Tại đây, chúng tôi cung cấp những thông tin mới nhất về tin tức nội bộ, chính sách xuất nhập khẩu, các quy định mới tại \u003cbold\u003eCửa khẩu Quốc tế Tà Lùng\u003c/bold\u003e và xu hướng vận tải quốc tế.\\n\\nViệc nắm bắt kịp thời các thay đổi về thủ tục hải quan và tình hình thông quan tại biên giới là yếu tố sống còn giúp doanh nghiệp tránh được các rủi ro về chậm trễ hàng hóa. Đội ngũ chuyên gia của Tà Lùng Quang Minh luôn nỗ lực tổng hợp và phân tích thị trường để mang lại những kiến thức giá trị nhất cho khách hàng.\",\"ctaTitle\":\"Bạn cần tư vấn giải pháp vận chuyển?\",\"ctaButton\":\"Gửi yêu cầu hỗ trợ\",\"viewOther\":\"Xem tin khác\",\"readMore\":\"Đọc tiếp\",\"allCategories\":\"Tất cả tin tức\",\"categoryPrefix\":\"Chuyên mục\",\"noNewsInCategory\":\"Hiện tại chưa có bài viết nào trong chuyên mục này.\",\"ctaDescription\":\"Liên hệ ngay để nhận được sự tư vấn chuyên nghiệp từ đội ngũ Tà Lùng Logistics.\",\"share\":\"Chia sẻ bài viết này\"},\"ServicesPage\":{\"title\":\"Dịch vụ Logistics\",\"description\":\"Giải pháp chuỗi cung ứng toàn diện tại Cửa khẩu Quốc tế Tà Lùng.\",\"noServices\":\"Hiện tại chưa có dịch vụ nào trong mục này.\",\"seoTitle\":\"Năng lực cung ứng dịch vụ tại Tà Lùng Logistics\",\"seoContent\":\"Tà Lùng Logistics tự hào là đơn vị tiên phong tại \u003cbold\u003eCửa khẩu Quốc tế Tà Lùng\u003c/bold\u003e. Chúng tôi cung cấp giải pháp trọn gói từ kho bãi, đại lý hải quan đến vận tải đa phương thức.\",\"ctaTitle\":\"Sẵn sàng tối ưu chuỗi cung ứng của bạn?\",\"ctaButton\":\"Liên hệ báo giá ngay\",\"categoryPrefix\":\"Chuyên mục\",\"ctaDescription\":\"Đội ngũ chuyên gia của Tà Lùng Logistics luôn sẵn sàng tư vấn và thiết kế giải pháp phù hợp nhất với nhu cầu kinh doanh của bạn.\"},\"ServiceDetail\":{\"ctaTitle\":\"Bạn cần một phương án logistics tối ưu hơn?\",\"ctaButton\":\"Liên Hệ Nhận Giải Pháp\",\"otherServicesTitle\":\"Dịch Vụ Liên Quan\",\"ctaDesc\":\"Liên hệ đội ngũ Tà Lùng Logistics để nhận tư vấn và báo giá tối ưu nhất.\",\"viewOther\":\"Xem dịch vụ khác\"},\"WhyChooseUs\":{\"title\":\"Bảo Chứng Cho Sự Thành Công\",\"point1Title\":\"Hạ Tầng Khép Kín \u0026 Quy Mô\",\"point1Text\":\"Sở hữu 25ha bãi tập kết với đầy đủ trang thiết bị nâng hạ hiện đại nhất ngay tại tâm điểm giao thương.\",\"point2Title\":\"Kinh Nghiệm Thực Chiến\",\"point2Text\":\"Đội ngũ chuyên gia am hiểu sâu sắc chính sách biên mậu, xử lý linh hoạt mọi tình huống thông quan 24/7.\",\"point3Title\":\"Tốc Độ \u0026 Minh Bạch\",\"point3Text\":\"Cam kết rút ngắn tối đa thời gian lưu bãi, quy trình thủ tục rõ ràng, chi phí minh bạch không phát sinh.\"},\"Partners\":{\"title\":\"Đối tác đồng hành cùng hàng trăm doanh nghiệp xuất nhập khẩu\"},\"ContactPage\":{\"title\":\"Kết Nối Cùng Chúng Tôi\",\"description\":\"Đội ngũ Tà Lùng Quang Minh luôn sẵn sàng lắng nghe và giải quyết mọi bài toán chuỗi cung ứng của bạn. Hãy liên hệ ngay hôm nay.\",\"infoTitle\":\"Trụ Sở \u0026 Liên Hệ\",\"address\":\"Địa chỉ\",\"phone\":\"Đường dây nóng\",\"email\":\"Email hỗ trợ\",\"salesDept\":\"Phòng Kinh Doanh Tiếp Thị\",\"opsDept\":\"Trung Tâm Điều Hành Xuất Nhập Khẩu\",\"hrDept\":\"Khối Nhân Sự - Tuyển Dụng\",\"formTitle\":\"Gửi Yêu Cầu Chuyên Môn\",\"faqTitle\":\"Giải Đáp Thắc Mắc\",\"faq\":{\"q1\":\"Tốc độ xử lý thông quan trung bình tại công ty là bao lâu?\",\"a1\":\"Với hồ sơ hợp lệ và sự chuẩn bị trước, thời gian xử lý thủ tục hải quan tại bãi của Tà Lùng Quang Minh trung bình chưa tới 2 giờ làm việc.\",\"q2\":\"Công ty có hỗ trợ sang tải hàng hóa đặc thù không?\",\"a2\":\"Hoàn toàn có. Với hệ thống thiết bị đa dạng và 25ha mặt bằng, chúng tôi có năng lực xử lý, sang tải an toàn mọi loại hàng hóa từ nông sản, khoáng sản đến máy móc siêu trường siêu trọng.\",\"q3\":\"Có thể yêu cầu vận tải đường thủy hoặc đường sắt không?\",\"a3\":\"Có. Tà Lùng Quang Minh tự hào cung cấp giải pháp vận tải đa phương thức, kết hợp linh hoạt đường bộ, đường thủy và đường sắt để tối ưu cước phí theo nhu cầu của bạn.\"},\"formSuccessTitle\":\"Gửi thành công!\",\"formSuccessDesc\":\"Yêu cầu của bạn đã được gửi. Chúng tôi sẽ phản hồi sớm nhất.\",\"formReset\":\"Gửi yêu cầu khác\",\"selectPlaceholder\":\"Chọn dịch vụ quan tâm...\",\"formNamePlaceholder\":\"Nguyễn Văn A\",\"formEmailPlaceholder\":\"email@example.com\",\"formPhonePlaceholder\":\"09xxxxxxxxx\",\"formMessagePlaceholder\":\"Tôi cần thông tin về dịch vụ...\",\"noOptions\":\"Không tìm thấy dịch vụ\",\"mapTitle\":\"Bản đồ kho bãi\",\"offices\":{\"addressCB\":\"Văn phòng tại Cao Bằng\",\"caobang\":\"Cửa khẩu Quốc tế Tà Lùng, xã Phục Hoà, tỉnh Cao Bằng\",\"addressQN\":\"Văn phòng tại Quảng Ninh\",\"halong\":\"Số 29 Lê Duẩn, phường Bãi Cháy, tỉnh Quảng Ninh\"}},\"CareersPage\":{\"title\":\"Phát Triển Sự Nghiệp\",\"subtitle\":\"Trở thành một mảnh ghép trong hệ sinh thái logistics dẫn đầu khu vực biên giới.\",\"noOpenings\":\"Hiện tại chưa có vị trí trống phù hợp.\",\"noOpeningsDesc\":\"Tuy nhiên, chúng tôi luôn chào đón nhân tài. Hãy chủ động gửi CV về phòng Nhân sự để không bỏ lỡ cơ hội trong tương lai.\",\"errorTitle\":\"Hệ thống đang bảo trì\",\"errorDesc\":\"Không thể tải danh sách tuyển dụng lúc này, vui lòng thử lại sau.\",\"retry\":\"Tải lại trang\",\"viewDetails\":\"Xem chi tiết công việc\"},\"CareerDetailPage\":{\"jobDescription\":\"Chi Tiết Công Việc\",\"requirements\":\"Chân Dung Ứng Viên\",\"applyTitle\":\"Tham Gia Cùng Chúng Tôi\",\"applySuccess\":\"Hồ sơ của bạn đã được ghi nhận! Bộ phận tuyển dụng sẽ sớm phản hồi.\",\"applyError\":\"Việc gửi hồ sơ gặp gián đoạn, vui lòng kiểm tra lại.\",\"form\":{\"nameLabel\":\"Họ và tên đầy đủ\",\"emailLabel\":\"Địa chỉ Email\",\"phoneLabel\":\"Số điện thoại liên hệ\",\"cvLabel\":\"Đính kèm CV (.pdf, .doc, .docx - Dung lượng \u003c 5MB)\",\"submitButton\":\"Nộp Hồ Sơ\",\"submittingButton\":\"Đang xử lý...\"},\"validation\":{\"nameRequired\":\"Vui lòng nhập họ và tên.\",\"emailInvalid\":\"Định dạng email không chính xác.\",\"phoneInvalid\":\"Số điện thoại không hợp lệ.\",\"cvRequired\":\"Vui lòng đính kèm hồ sơ năng lực (CV) của bạn.\",\"cvMaxSize\":\"Dung lượng tệp vượt quá giới hạn 5MB.\",\"cvFormat\":\"Định dạng tệp không được hỗ trợ.\"},\"notFound\":\"Công việc này đã hết hạn hoặc không tồn tại.\"},\"ManifestoPage\":{\"title\":\"Tuyên Ngôn Giá Trị\",\"subtitle\":\"KẾT NỐI BIÊN GIỚI - VƯƠN TỚI TOÀN CẦU\",\"value1Title\":\"Chính Xác \u0026 Minh Bạch\",\"value1Text\":\"Mọi quy trình từ báo giá đến thông quan đều được chuẩn hóa. Khách hàng nắm rõ mọi chi phí và lộ trình hàng hóa.\",\"value2Title\":\"Tốc Độ \u0026 Linh Hoạt\",\"value2Text\":\"Thời gian là lợi nhuận của khách hàng. Chúng tôi phản ứng nhanh chóng để tháo gỡ mọi điểm nghẽn trong khâu vận hành.\",\"value3Title\":\"Đồng Hành Cùng Phát Triển\",\"value3Text\":\"Thành công của đối tác chính là thước đo năng lực của chúng tôi. Tà Lùng Quang Minh hướng đến những mối quan hệ hợp tác chiến lược dài hạn.\",\"value4Title\":\"Trách Nhiệm Cộng Đồng\",\"value4Text\":\"Vận hành doanh nghiệp không tách rời ý thức bảo vệ môi trường và đóng góp vào sự hưng thịnh của kinh tế vùng biên.\"},\"Search\":{\"placeholder\":\"Gõ từ khóa để tìm kiếm...\",\"noResults\":\"Không có kết quả nào phù hợp với từ khóa của bạn.\",\"services\":\"Dịch vụ\",\"news\":\"Tin tức\"},\"TrackingPage\":{\"title\":\"Trung Tâm Tra Cứu Vận Đơn\",\"trackingPlaceholder\":\"Nhập mã vận đơn (AWB) cần tra cứu...\",\"searchButton\":\"Kiểm Tra\",\"loading\":\"Hệ thống đang truy xuất dữ liệu...\",\"loadingPage\":\"Đang kết nối...\",\"errorTitle\":\"Lỗi Kết Nối\",\"errorDescription\":\"Máy chủ đang bận, xin vui lòng kiểm tra lại sau ít phút.\",\"notFoundTitle\":\"Mã Vận Đơn Không Hợp Lệ\",\"notFoundDescription\":\"Hệ thống không ghi nhận dữ liệu cho mã: {awbs}. Vui lòng xác minh lại thông tin với người gửi.\",\"resultsFor\":\"Trạng thái hiện tại của:\",\"noEvents\":\"Lô hàng đang trong quá trình cập nhật trạng thái đầu tiên.\"},\"Footer\":{\"companyName\":\"Công ty Cổ phần Tà Lùng Quang Minh\",\"taxCode\":\"Mã số doanh nghiệp / MST: 4800155257\",\"address\":\"Trụ sở: Cửa khẩu Quốc tế Tà Lùng, xã Phục Hoà, tỉnh Cao Bằng, Việt Nam\",\"sitemap\":\"Sơ đồ trang\",\"legal\":\"Thông tin pháp lý\",\"terms\":\"Điều khoản dịch vụ\",\"privacy\":\"Bảo mật thông tin\",\"quickContact\":\"Gửi thông điệp nhanh\",\"formName\":\"Họ tên của bạn\",\"formEmail\":\"Email liên hệ\",\"formMessage\":\"Chúng tôi có thể giúp gì cho bạn?\",\"formPhone\":\"Số điện thoại\",\"formServiceId\":\"Mảng dịch vụ quan tâm\",\"formSend\":\"Yêu Cầu Hỗ Trợ\",\"formSuccess\":\"Yêu cầu đã được gửi thành công. Chuyên viên sẽ gọi lại cho bạn sớm nhất.\",\"formSubmitting\":\"Hệ thống đang tiếp nhận...\",\"formError\":\"Lỗi đường truyền, vui lòng gửi lại.\",\"copyright\":\"© 2026 Tà Lùng Quang Minh. Bảo lưu mọi quyền lợi.\",\"tracking\":\"Tra cứu lộ trình\"},\"Errors\":{\"goBackTo\":\"Trở về {pageName}\",\"retry\":\"Tải lại\",\"faile